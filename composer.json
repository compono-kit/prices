{
	"name": "compono-kit/prices",
	"description": "Implementations for compono-kit/price-interfaces",
	"license": "MIT",
	"authors": [
		{
			"name": "Benjamin Bruska",
			"email": "benjamin.bruska@your-coder.de"
		}
	],
	"require": {
		"php": ">=8.5",
		"compono-kit/money-interfaces": "^2.0",
		"compono-kit/price-interfaces": "^2.0"
	},
	"require-dev": {
		"phpstan/phpstan": "^2.1",
		"phpstan/phpstan-phpunit": "^2.0",
		"phpunit/phpunit": "^12.0",
		"roave/security-advisories": "dev-latest"
	},
	"autoload": {
		"psr-4": {
			"ComponoKit\\Prices\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"ComponoKit\\Prices\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit -c build/phpunit.xml",
		"analyse": "phpstan analyse -c build/phpstan.neon",
		"check": [
			"@analyse",
			"@test"
		]
	},
	"config": {
		"sort-packages": true
	}
}
